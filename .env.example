# ==== BANCO DE DADOS (Obrigatório para Persistência) ====
DB_HOST=database
DB_PORT=5432
DB_SSLMODE=disable
POSTGRES_USER=trainee_user
POSTGRES_PASSWORD=trainee_password
POSTGRES_DB=scraper_db

# ==== CONFIGURAÇÕES DO SCRAPER ====
SCRAPER_PARALLELISM=2
SCRAPER_DELAY=1s

# ==== CONFIGURAÇÕES DA IA (Bônus) ====
GEMINI_API_KEY=sua_chave_aqui_sem_aspas
API_RETRY_LIMIT=3
API_BACKOFF_DURATION=2s

# ==== CONFIGURAÇÕES DE BROWSER (Bônus) ====
BROWSER_TIMEOUT=20s
BROWSER_TARGET_URL=http://quotes.toscrape.com/js/
